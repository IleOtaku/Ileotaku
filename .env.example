# ÍléOtaku — environment variable reference.
# Copy this file to .env.local and fill in real values. Never commit .env.local — it's already
# covered by .gitignore. See SETUP.md and DEPLOY.md for where to find/generate each of these.

# Firebase
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_firebase_project_id_here
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_firebase_messaging_sender_id_here
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id_here

# Cloudinary — replaces Firebase Storage for every user upload (avatars, cover art, feed
# images/video, creator sound uploads, chapter pages). The two NEXT_PUBLIC_ values are safe to
# expose to the browser (unsigned upload preset); the API key/secret are server-only, used by
# app/api/cloudinary/delete/route.ts to sign delete requests.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name_here
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your_unsigned_upload_preset_here
CLOUDINARY_API_KEY=your_cloudinary_api_key_here
CLOUDINARY_API_SECRET=your_cloudinary_api_secret_here

# Paystack — coin purchases and Platinum subscriptions. Get test/live keys from
# https://dashboard.paystack.com/#/settings/developer
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=your_paystack_public_key_here
PAYSTACK_SECRET_KEY=your_paystack_secret_key_here

# Spotify — Now Playing, Listen Along, and per-user search (Authorization Code flow).
# NEXT_PUBLIC_SPOTIFY_REDIRECT_URI must exactly match a Redirect URI registered on this app in
# the Spotify Developer Dashboard. SPOTIFY_CLIENT_SECRET is server-only.
NEXT_PUBLIC_SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here
NEXT_PUBLIC_SPOTIFY_REDIRECT_URI=http://localhost:3000/auth/spotify/callback

# PropellerAds — served to free (non-Platinum) users only. Placeholders are fine until you have
# a real PropellerAds account; AdSlot renders a dev-only placeholder (or nothing in production)
# when these are unset.
NEXT_PUBLIC_PROPELLERADS_PUBLISHER_ID=your_publisher_id_here
NEXT_PUBLIC_PROPELLERADS_ZONE_BETWEEN_CHAPTERS=your_zone_id_here
NEXT_PUBLIC_PROPELLERADS_ZONE_PROFILE=your_zone_id_here

# Monetag — Multitag script (components/ads/MonetagScript.tsx, free readers only) and the
# service-worker push zone (public/sw.js's self.options block, kept in sync with this value).
NEXT_PUBLIC_MONETAG_ZONE_ID=278904
NEXT_PUBLIC_MONETAG_SW_ZONE_ID=11773167

# Firebase Admin — server-only, used by app/api/notifications/send/route.ts (via firebase-admin)
# to deliver push notifications. Paste the full contents of your Firebase service account JSON
# (Firebase Console → Project Settings → Service Accounts → Generate new private key) as a single
# line. Never commit the real value or the downloaded JSON file itself.
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...", ...}

# App
NEXT_PUBLIC_APP_URL=https://ileotaku.vercel.app
NEXT_TELEMETRY_DISABLED=1
