rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // Mirrors lib/creatorFeed.ts's getForYouEligibility() so a post's `forYouEligible` flag can
    // never be self-declared out of step with the author's own role — only Creator/Publisher
    // accounts in good standing (not banned) may claim eligibility at create time. Uses
    // map.get(key, default) rather than dot access for every field: unlike JS, reading a map key
    // that doesn't exist on the document (e.g. an account that has never been banned, so
    // `isBanned` was never written) is a rules EVALUATION ERROR, not `null`/`undefined` — one
    // that surfaces to the client as a blanket "Missing or insufficient permissions" with no
    // hint it was actually a missing-field issue in the rule itself.
    //
    // The same class of problem applies one level up: get() on a users/{uid} path that doesn't
    // exist AT ALL throws too, not just a missing field on an existing doc — confirmed live as
    // the actual cause of "posting fails for a regular user": an account whose upsertUserProfile
    // call never finished right after signup (tab closed, network drop) stays signed into
    // Firebase Auth indefinitely with no Firestore profile at all, since the old signInEmail
    // only ever ran updateDoc (which needs the doc to already exist) and swallowed its own
    // failure. lib/auth.ts's signInEmail now backfills a missing profile the same way
    // signInSocial already did for its existing-user branch, but this function guards
    // independently too — every other allow-create rule that calls it should get a real
    // false/true answer instead of an opaque permission error, regardless of what state a
    // profile document happens to be in.
    function computedForYouEligible() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isCreator', false) == true ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isPublisher', false) == true) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isBanned', false) != true;
    }

    // ---------------------------- handles (username reservation) ----------------------------
    // handles/{handle} (doc id is the LOWERCASED handle — see HandleReservation's own doc
    // comment in types/index.ts for why) is a pure reservation record, {uid, createdAt}, written
    // in the same client transaction as the users/{uid}.handle update it backs — see
    // lib/handles.ts's claimHandle(). A signed-in user may create a reservation that doesn't
    // exist yet, or update/delete one they already own; they can never touch someone else's.
    // `resource == null` is this ruleset's own idiom for "no document exists yet" (see
    // /conversations/{conversationId}'s read rule below for the same pattern) — reading
    // resource.data on a create, before any document exists, would otherwise throw outright.
    match /handles/{handle} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && (resource == null || resource.data.uid == request.auth.uid);
    }

    // ---------------------------- users ----------------------------
    // Profiles are publicly readable — /creator/[handle] is a public page rendered by a
    // server component, which has no Firebase Auth session at all, so gating reads behind
    // isSignedIn() breaks that page (and any other server-rendered or logged-out view) with
    // a hard "Missing or insufficient permissions" crash. Only writes are locked to the owner.
    match /users/{uid} {
      allow read: if true;
      // Same handle-reservation guard as `update` below applies here too — upsertUserProfile()
      // never actually sets `handle` at creation time (a brand-new profile has none until the
      // Edit Profile form's first save), but a crafted create() call could otherwise set one
      // straight into the document with no reservation to back it, same loophole as bypassing
      // `update` this way would.
      allow create: if isOwner(uid)
        && (request.resource.data.get('handle', null) == null
          || (exists(/databases/$(database)/documents/handles/$(request.resource.data.handle.lower()))
            && get(/databases/$(database)/documents/handles/$(request.resource.data.handle.lower())).data.uid == uid));
      // followCreator/unfollowCreator (lib/firestore.ts) write BOTH sides of a follow in one
      // call: arrayUnion(targetUid) onto the follower's own `following`, then arrayUnion(myUid)
      // onto the TARGET's `followers` — that second write is on someone else's document, which
      // isOwner(uid) alone rejects outright. Confirmed live: this was the actual cause of "the
      // follow button doesn't work anywhere" — the first write succeeded, the second threw
      // permission-denied, followUser's catch fired, and the button silently reset. blockUser
      // (lib/blocking.ts) has the identical shape on its cross-user cleanup write, touching both
      // `following` AND `followers` on the *target's* doc in one updateDoc — it was already
      // failing the same way, just silently: that call is wrapped in its own .catch(logError),
      // so the block record itself still wrote, but the target never actually lost the follow
      // edge. Scoped to only these two social-graph fields (any other field on someone else's
      // profile still needs isOwner/isAdmin), matching this file's existing precedent of
      // trusting isSignedIn() for writes made on another uid's behalf (see `transactions` below).
      // Beyond who may update this doc at all (the OR set below, unchanged), a SEPARATE check
      // guards the `handle` field specifically: its value may only actually change when a
      // matching handles/{newHandleLower} reservation already exists and is owned by this uid —
      // otherwise the reservation system above would be pure theater, since isOwner(uid) alone
      // would still let a client bypass claimHandle() entirely with a raw updateDoc() straight to
      // this document. Every update that leaves `handle` untouched (the overwhelming majority —
      // bio edits, coin balance changes, admin moderation, the follow/unfollow carve-out) trivially
      // satisfies the first branch below and is completely unaffected by this.
      allow update: if (isOwner(uid) || isAdmin() ||
        (isSignedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followers', 'following'])))
        && (request.resource.data.get('handle', null) == resource.data.get('handle', null)
          || (request.resource.data.get('handle', null) != null
            && exists(/databases/$(database)/documents/handles/$(request.resource.data.handle.lower()))
            && get(/databases/$(database)/documents/handles/$(request.resource.data.handle.lower())).data.uid == uid));
      // Sprint 9d: self-service account deletion (deleteMyAccount() in lib/auth.ts) needs the
      // owner to be able to delete their own profile document, not just an admin moderating
      // someone else's — confirmed live during testing that this was previously owner-deletion's
      // only remaining blocker after every subcollection had already been cleared.
      allow delete: if isOwner(uid) || isAdmin();

      // Notifications are written by whoever triggers them (a follow, a reply, a tip — not
      // necessarily the notification's own owner), so create is open to any signed-in user;
      // only the owner can read, mark-read, or delete their own notifications.
      match /notifications/{notifId} {
        allow read, update: if isOwner(uid);
        allow create: if isSignedIn();
        // Owner clears their own notifications one at a time; admin delete is here only for
        // adminDeleteUserData's (lib/admin.ts) bulk cleanup of a MODERATED account's data.
        allow delete: if isOwner(uid) || isAdmin();
      }

      // Reading history is written only by the account itself, but read more broadly: the
      // Friend Activity widget shows what people you follow are reading, so any signed-in
      // reader can see it — treat it like the rest of this app's largely-public activity data.
      match /history/{historyId} {
        allow read: if isSignedIn();
        allow create: if isOwner(uid);
        allow update, delete: if isOwner(uid) || isAdmin();
      }

      // Coin ledger. Some entries are written on behalf of a DIFFERENT uid (tipCreator credits
      // the recipient's transactions from the sender's session), so create stays open to any
      // signed-in user; the ledger itself is otherwise read-only from the client once written.
      match /transactions/{txId} {
        allow read: if isOwner(uid) || isAdmin();
        allow create: if isSignedIn();
        allow update, delete: if isAdmin();
      }

      // Coin-unlocked chapters — private to the account that unlocked them. Admin write is here
      // only for adminDeleteUserData's bulk cleanup of a moderated account's data.
      match /unlocked/{chapterId} {
        allow read: if isOwner(uid);
        allow write: if isOwner(uid) || isAdmin();
      }

      // Feed post drafts (Sprint 9b) — never readable by anyone but their own author, unlike
      // the public `creatorFeed` collection published posts live in.
      match /drafts/{draftId} {
        allow read, write: if isOwner(uid);
      }

      // Sprint 9d: Spotify OAuth grant — access/refresh tokens, never readable by anyone but
      // the account they belong to (and never written by anyone but the owner's own client,
      // via the token/refresh exchange routes and disconnectSpotify()).
      match /spotifyAuth/{docId} {
        allow read, write: if isOwner(uid);
      }

      // Now Playing snapshot — readable by any signed-in user (that's the whole point: other
      // people's profile pages, DM headers, and comment rows show it), but only the account
      // itself ever writes its own snapshot (via startNowPlayingSync()'s periodic sync).
      match /nowPlaying/{docId} {
        allow read: if isSignedIn();
        allow write: if isOwner(uid);
      }

      // Sprint 9e: blocklist. Write is owner-only (only you can block/unblock on your own
      // behalf), but read is open to any signed-in user rather than owner-only — a strictly
      // owner-only read would make isBlockedBy() (lib/blocking.ts) impossible to ever satisfy:
      // checking "has this OTHER profile blocked me" inherently means reading a document that
      // lives under *their* uid while signed in as *myself*, which owner-only read can never
      // permit no matter whose side initiates it. The trade-off is a narrow, low-sensitivity
      // leak (anyone who already knows both uids can confirm a specific block exists) in
      // exchange for the profile-visit / DM / comment gates actually being able to function.
      // Admin write is here only for adminDeleteUserData's (lib/admin.ts) bulk cleanup of a
      // moderated account's data — everyday reads/writes are still owner-only.
      match /blocked/{targetUid} {
        allow read: if isSignedIn();
        allow write: if isOwner(uid) || isAdmin();
      }

      // Sprint 9e: "currently reading" live status — same read-broadly/write-only-self shape
      // as nowPlaying, for the same reason (profile pages and Friend Activity need to read
      // OTHER users' activity, but only the account itself ever updates its own). Admin write is
      // here only for adminDeleteUserData's bulk cleanup of a moderated account's data.
      match /readingActivity/{docId} {
        allow read: if isSignedIn();
        allow write: if isOwner(uid) || isAdmin();
      }

      // Bookmarked feed posts (profile Library tab's "Saved Posts" section) — never readable by
      // anyone but their own owner, same shape as `drafts` above.
      match /savedPosts/{postId} {
        allow read, write: if isOwner(uid);
      }

      // Sprint "Polish-2" Part 4: purchaseVisitorReveal()'s 24h unlock record — private to the
      // account that bought it (whose profile it unlocks other visitors' identities on), same
      // shape as `drafts`/`savedPosts` above.
      match /revealedVisitors/{profileUid} {
        allow read, write: if isOwner(uid);
      }
    }

    // Sprint "Polish-2" Part 4: profileVisits/{profileUid}/visitors/{visitorUid} — who visited
    // profileUid's profile. Read is owner-of-profileUid-or-admin only (a visitor list is private
    // to the profile it belongs to, unlike most of this app's largely-public activity data).
    // Write is any signed-in user, but ONLY on their own visitorUid subdocument — recordVisit()
    // (lib/profileVisits.ts) always writes visitorUid == request.auth.uid, matching the same
    // "narrow, self-scoped write on someone else's document" shape as the `blocked` subcollection
    // above (isOwner(profileUid) can never be true here, since the writer is visiting SOMEONE
    // ELSE's profile by definition).
    match /profileVisits/{profileUid}/visitors/{visitorUid} {
      allow read: if isSignedIn() && (request.auth.uid == profileUid || isAdmin());
      allow write: if isSignedIn() && request.auth.uid == visitorUid;
    }

    // ---------------------------- Spotify Listen Along (Sprint 9d) ----------------------------
    // One ephemeral session doc per host, keyed by their own uid. Write is open to any
    // signed-in user (not just the host) because listenAlong()/leaveListenSession() are called
    // by *listeners* joining or leaving someone else's session, the same "write on someone
    // else's document, but only touching a narrow field" shape as creatorFeed's likes toggle —
    // here the whole document is small and ephemeral enough that a full write rule (rather than
    // an affectedKeys().hasOnly(["listeners"]) restriction) is an acceptable simplification.
    match /listenSessions/{hostUid} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Collection-group reads for `transactions`/`history` (lib/admin.ts's revenue/stats
    // rollups use collectionGroup() to read across every user at once). Firestore requires
    // the recursive {path=**} wildcard specifically to authorize collection-group queries —
    // the nested `match /users/{uid}/transactions/{txId}` rules above cover direct,
    // single-user reads/writes only and do NOT extend to a query spanning all users, even
    // though they match the identical document paths for a plain get(). Without this block,
    // every collectionGroup(db, "transactions"/"history") call is rejected outright before a
    // single document is evaluated, regardless of the requester's role.
    match /{path=**}/transactions/{txId} {
      allow read: if isSignedIn() && (isAdmin() || path[1] == request.auth.uid);
    }
    match /{path=**}/history/{historyId} {
      allow read: if isSignedIn();
    }

    // ---------------------------- chats ----------------------------
    // Messages can be read by any signed-in user and created only by their own sender,
    // with a hard cap on message length. Edits/deletes are admin-only (moderation).
    match /chats/{chatId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() < 500;
      allow update, delete: if isAdmin();
    }

    // Actual runtime shape used by the app: chatRooms/{roomId}/messages/{messageId}.
    match /chatRooms/{roomId} {
      allow read: if isSignedIn();
      allow write: if false; // room metadata is managed server-side only

      match /messages/{messageId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn()
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() < 500;
        // Admin moderation keeps full rights; the sender may additionally edit or soft-delete
        // their own message, scoped to exactly the fields lib/firestore.ts's
        // editChatMessage/deleteChatMessage ever touch — same pattern as DM messages above.
        allow update: if isAdmin()
          || (isSignedIn() && resource.data.senderId == request.auth.uid
            && (request.resource.data.diff(resource.data).affectedKeys().hasOnly(["text", "isEdited", "editedAt"])
              || request.resource.data.diff(resource.data).affectedKeys().hasOnly(["text", "isDeleted", "deletedAt"])));
        allow delete: if isAdmin();
      }
    }

    // ---------------------------- works ----------------------------
    // Published works are a public catalog (browsed from server-rendered pages with no auth
    // session), so reads are public; only the submitting creator can create/update their own,
    // and admins can moderate any (approve/reject).
    match /works/{workId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
      allow update: if isSignedIn()
        && (resource.data.authorId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    // Actual runtime collection used by the app.
    match /creatorWorks/{workId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.creatorId == request.auth.uid;
      // The current owner may change anything on their own work (Part 12's edit-series-details,
      // add/delete chapter counters, etc). A DIFFERENT signed-in user may ONLY ever rewrite the
      // 5 ownership fields — never anything else — which is exactly and only what
      // respondToOwnershipTransfer() (lib/publishedSeries.ts) sends when a transfer's recipient
      // accepts it. Trusts that function's own check (it reads the transfer request doc and
      // confirms the caller is its `toUid` before writing) rather than re-deriving "is there a
      // pending transfer to this uid for this work" here — Firestore rules can only check exact
      // document paths, not run a query, and the request doc's id is a random auto-id with no
      // deterministic path to look up. Same trust-the-app-layer precedent already used for the
      // `conversations` group-admin fields above.
      allow update: if isSignedIn()
        && (resource.data.creatorId == request.auth.uid
          || isAdmin()
          || request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(["creatorId", "authorId", "authorName", "authorHandle", "authorPhotoURL"]));
      allow delete: if isSignedIn() && (resource.data.creatorId == request.auth.uid || isAdmin());
    }

    // ---------------------------- published series (Sprint 9f) ----------------------------
    // Public-facing summary of an approved creatorWorks doc — Explore's African Originals rail,
    // /manga/[id], and /creator/[handle]'s Works tab all read from here (never from creatorWorks
    // directly) so a pending/rejected work never needs public read access. Only admin approval
    // creates one; the work's own author can update theirs afterwards (chapterCount bumps from
    // the Add Chapter flow), same shape as `creatorWorks` above.
    match /publishedSeries/{workId} {
      allow read: if true;
      allow create: if isAdmin();
      // See creatorWorks' update rule above for the same ownership-transfer-acceptance carve-out
      // (same 5 fields, same trust-the-app-layer reasoning). The `totalReads` carve-out is new:
      // incrementSeriesReads() (lib/publishedSeries.ts) is called by ANY signed-in reader who
      // opens a chapter, not just the work's own author, so it needs its own narrow allowance —
      // same "any signed-in user, one field only" shape as `likes` elsewhere in this ruleset.
      allow update: if isAdmin()
        || (isSignedIn() && resource.data.authorId == request.auth.uid)
        || (isSignedIn() && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(["authorId", "authorName", "authorHandle", "authorPhotoURL"]))
        || (isSignedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["totalReads"]));
      allow delete: if isAdmin() || (isSignedIn() && resource.data.authorId == request.auth.uid);
    }

    // ---------------------------- ownership transfers (Part 12) ----------------------------
    // A creator-to-creator series handoff request. Created by the sender, only ever updated by
    // its own recipient (accept/decline) or an admin — the sender can't self-approve their own
    // request by writing straight to it.
    match /ownershipTransfers/{requestId} {
      allow read: if isSignedIn()
        && (request.auth.uid == resource.data.fromUid || request.auth.uid == resource.data.toUid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.fromUid == request.auth.uid;
      allow update: if isSignedIn() && (request.auth.uid == resource.data.toUid || isAdmin());
    }

    // ---------------------------- series (comments & ratings) ----------------------------
    // `series/{seriesId}` is keyed by the creator work's own id (see lib/publishedSeries.ts) —
    // it holds each work's chapters subcollection plus social metadata: comments, ratings, and
    // the average/count rollup submitRating recomputes.
    match /series/{seriesId} {
      allow read: if true;
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();

      match /comments/{commentId} {
        allow read: if true;
        allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
        // The comment's own author can change anything on it; anyone else signed in may only
        // toggle the `likes` array — that's how liking someone else's comment writes.
        allow update: if isSignedIn()
          && (resource.data.userId == request.auth.uid
            || request.resource.data.diff(resource.data).affectedKeys().hasOnly(["likes"]));
        allow delete: if isSignedIn()
          && (resource.data.userId == request.auth.uid || isAdmin());
      }

      match /chapters/{chapterId}/comments/{commentId} {
        allow read: if true;
        allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
        allow update: if isSignedIn()
          && (resource.data.userId == request.auth.uid
            || request.resource.data.diff(resource.data).affectedKeys().hasOnly(["likes"]));
        allow delete: if isSignedIn()
          && (resource.data.userId == request.auth.uid || isAdmin());
      }

      // Sprint 9f: a creator work's actual chapter pages, keyed by the same id as its
      // publishedSeries/{seriesId} summary — only that work's own author (or an admin) may add,
      // edit, or delete chapters, checked with a lookup against the summary doc's authorId since
      // a chapter doc carries no uid of its own to compare directly. Delete widened from
      // admin-only (Sprint 9f's original scope, which had no creator-facing delete flow yet) to
      // match create/update once Part 12's deleteWork()/updateChapter() needed the work's own
      // author to be able to remove their own chapters, not just an admin.
      match /chapters/{chapterId} {
        allow read: if true;
        // Sprint "Polish-2" Part 1: incrementChapterReads() (lib/publishedSeries.ts) is called by
        // ANY signed-in reader who opens a chapter, not just the work's own author — same
        // "any signed-in user, one field only" carve-out publishedSeries' own totalReads field
        // already has above, needed here for the identical reason.
        allow update: if isSignedIn()
          && (isAdmin()
            || get(/databases/$(database)/documents/publishedSeries/$(seriesId)).data.authorId == request.auth.uid
            || request.resource.data.diff(resource.data).affectedKeys().hasOnly(["readCount"]));
        allow create, delete: if isSignedIn()
          && (isAdmin()
            || get(/databases/$(database)/documents/publishedSeries/$(seriesId)).data.authorId == request.auth.uid);
      }

      // Part 12: saved-but-not-yet-published chapters — same author-or-admin ownership check as
      // `chapters` above, but private (not publicly readable — a draft isn't meant to be seen by
      // anyone but its own creator until it's actually published). Guarded with exists() before
      // each get(): a work can save drafts before it's even been approved, when its
      // publishedSeries summary doesn't exist yet — get() on a missing doc throws outright
      // (unlike a plain missing FIELD on an existing doc), same reasoning as isAdmin()'s guard.
      match /draftChapters/{draftId} {
        allow read, create, update, delete: if isSignedIn()
          && (isAdmin()
            || (exists(/databases/$(database)/documents/publishedSeries/$(seriesId))
              && get(/databases/$(database)/documents/publishedSeries/$(seriesId)).data.authorId == request.auth.uid)
            || (exists(/databases/$(database)/documents/creatorWorks/$(seriesId))
              && get(/databases/$(database)/documents/creatorWorks/$(seriesId)).data.creatorId == request.auth.uid));
      }

      match /ratings/{userId} {
        allow read: if true;
        allow create, update: if isOwner(userId);
        allow delete: if isOwner(userId) || isAdmin();
      }
    }

    // ---------------------------- direct messages ----------------------------
    match /conversations/{conversationId} {
      // startConversation() always does a getDoc() first to check whether the 1:1 conversation
      // already exists before creating it. For a brand-new pair of users that document doesn't
      // exist yet, so `resource` is null on that read — referencing resource.data.participants
      // directly (with no null check) denied that existence check unconditionally, which broke
      // starting a first conversation for everyone. `update` never runs against a nonexistent
      // doc (there's nothing to update), so it doesn't need the same null guard.
      allow read: if isSignedIn()
        && (resource == null || request.auth.uid in resource.data.participants);
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.participants;
      // Two update shapes: (1) any current participant may bump the message-send side effects
      // (sendDM, markDMRead) — unchanged from before groups existed. (2) group-only fields —
      // name/description/photoURL/membership/adminUids — scoped to a NARROWER set of keys than
      // (1), but (like the rest of this ruleset's group support) trusts the calling app's own
      // admin check in lib/dms.ts rather than re-deriving "is this specific uid an admin" from
      // an array diff here; a crafted direct SDK call could bypass that app-level check the same
      // way a crafted call already could for e.g. `chats`' create above. Tightening that further
      // is a real improvement to make later, not a regression this introduces.
      allow update: if isSignedIn() && request.auth.uid in resource.data.participants
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
          ["lastMessage", "lastMessageAt", "lastSenderId", "unreadCounts",
           "name", "description", "photoURL", "participants", "participantNames",
           "participantPhotos", "adminUids"]);
      // The group's creator only (deleteGroup in lib/dms.ts) — a 1:1 conversation is never
      // deleted, only left implicitly by no longer being messaged.
      allow delete: if isSignedIn() && resource.data.creatorUid == request.auth.uid;

      match /messages/{messageId} {
        allow read: if isSignedIn()
          && request.auth.uid in
            get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
        allow create: if isSignedIn() && request.resource.data.senderId == request.auth.uid;

        // Four distinct update shapes, each scoped to exactly the field(s) that operation
        // touches so none of them can be used to smuggle a change to anything else on the
        // message — editMessage/deleteMessage/addReaction/removeReaction in lib/dms.ts are the
        // only callers, and none of them ever sends a diff wider than its own case below.
        allow update: if isSignedIn()
          && request.auth.uid in
            get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants
          && (
            // Edit own message text.
            (resource.data.senderId == request.auth.uid
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["text", "isEdited", "editedAt"]))
            // Delete for everyone — own message only, content replaced with the placeholder.
            || (resource.data.senderId == request.auth.uid
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["text", "isDeleted", "deletedAt"]))
            // Delete for me — any participant, and only their OWN view is affected.
            || request.resource.data.diff(resource.data).affectedKeys().hasOnly(["deletedFor"])
            // React / un-react — any participant.
            || request.resource.data.diff(resource.data).affectedKeys().hasOnly(["reactions"])
          );
      }
    }

    // ---------------------------- reports ----------------------------
    // Anyone signed in can file a report as themselves; only admins can read or triage them.
    match /reports/{reportId} {
      allow read: if isAdmin();
      allow create: if isSignedIn() && request.resource.data.reporterId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // ---------------------------- maintenance ----------------------------
    // Public read (MaintenanceGate subscribes to this with no auth session on some routes);
    // only admins can write. Requests awaiting Super Admin approval are admin-only end to end.
    match /maintenance/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /maintenanceRequests/{requestId} {
      allow read, write: if isAdmin();
    }

    // ---------------------------- admin: error logs ----------------------------
    // logError() can fire from a render-time ErrorBoundary before auth has resolved, or from a
    // signed-out page — create stays open so a crash is never itself silently unloggable; only
    // admins can read/triage the log.
    match /errors/{errorId} {
      allow read, update: if isAdmin();
      allow create: if true;
      allow delete: if isAdmin();
    }

    // ---------------------------- admin: bug reports ----------------------------
    // Anyone (including signed-out visitors) can file a bug report from the Footer. The
    // reporter can read back their own report (to see the technical team's note on their
    // profile); full listing/triage is admin-only.
    match /bugReports/{bugId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.reportedBy == request.auth.uid);
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // ---------------------------- admin: contact messages ----------------------------
    // Same shape as bugReports above: the public /contact page's form works for signed-out
    // visitors, so create stays fully open; only admins ever read the inbox.
    match /contactMessages/{messageId} {
      allow read, update, delete: if isAdmin();
      allow create: if true;
    }

    // ---------------------------- beta feedback (Sprint 10) ----------------------------
    // Same shape as contactMessages/bugReports: the floating Beta Feedback button works for
    // signed-out visitors too, so create stays fully open; only admins triage it.
    match /betaFeedback/{feedbackId} {
      allow read, update, delete: if isAdmin();
      allow create: if true;
    }

    // ---------------------------- admin: announcements ----------------------------
    // The announcement record itself (compose history) is admin-only; actual delivery to
    // users happens through their own notifications subcollection, which already has its own
    // rules and needs none of these.
    match /announcements/{announcementId} {
      allow read, write: if isAdmin();
    }

    // ---------------------------- admin: creator payouts ----------------------------
    // A creator may read their own payout rows; only admins can read the full ledger or write.
    match /earnings/{earningId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.creatorId == request.auth.uid);
      allow write: if isAdmin();
    }

    // ---------------------------- admin: ban audit trail ----------------------------
    match /bannedEmails/{uid} {
      allow read, write: if isAdmin();
    }

    // ---------------------------- creator feed ----------------------------
    // Posts are readable by any signed-in user (the "For You"/"Following" feed and creator
    // profile Posts tabs); only the post's own author may create, edit, or delete it — likes
    // are the one exception, allowed on someone else's post but restricted to touching just the
    // `likes` field, the same pattern comments already use for their like toggle.
    match /creatorFeed/{postId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.forYouEligible == computedForYouEligible();
      // Beyond the post's own author (full edit rights) and an admin (moderation), narrow
      // any-signed-in-user carve-outs mirror what the client actually writes without its own
      // uid: liking someone else's post (`likes` only — comments already use this pattern);
      // incrementViewCount()/trackWatchTime()/trackVideoCompleted()/trackVideoReplay()/
      // trackProfileVisit()/trackShare() bumping a post's engagement counters plus the
      // forYouScore each recomputes in the same call; and addFeedComment()/deleteFeedComment()
      // bumping `commentCount` (also alongside forYouScore).
      allow update: if isSignedIn()
        && (resource.data.uid == request.auth.uid
          || isAdmin()
          || request.resource.data.diff(resource.data).affectedKeys().hasOnly(["likes"])
          // Sprint "Polish-2" Part 8: profileVisitsFromPost (trackProfileVisit's renamed field —
          // profileVisits kept too, since bumpEngagementCounter's Math.max(0, ...) floor on
          // savePost/unsavePost's bookmarkCount delta is the only other change to this list) and
          // bookmarkCount (savePost()/unsavePost()) join the same "any signed-in user, engagement
          // counters + forYouScore only" carve-out the rest of this list already covers.
          || request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(["viewCount", "watchTime", "forYouScore", "completedViews", "replayCount",
                "profileVisits", "profileVisitsFromPost", "shareCount", "commentCount", "bookmarkCount"]));
      allow delete: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());

      // ---------------------------- feed post comments ----------------------------
      // Same threaded-comment shape as series comments (top-level + one level of replies via
      // `parentId`, soft-delete, like-toggle carve-out) — see components/social/CommentSection.tsx
      // and lib/firestore.ts's postComment()/toggleCommentLike() for the pattern this mirrors.
      match /comments/{commentId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
        allow update: if isSignedIn()
          && (resource.data.uid == request.auth.uid
            || isAdmin()
            || request.resource.data.diff(resource.data).affectedKeys().hasOnly(["likes"]));
        allow delete: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      }
    }

    // ---------------------------- manga engagement stats (Sprint 9c) ----------------------------
    // Read/write-tracking doc per imported manga (totalReads, engagementTier) that powers
    // chapter locking — public read (the manga detail page renders lock icons for signed-out
    // visitors too, server-side with no auth session, same reasoning as `users/{uid}` above);
    // write is open to any signed-in reader since trackMangaRead() fires from every reader's own
    // client as they read, not from some privileged/admin-only process.
    match /mangaStats/{mangaId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // ---------------------------- sounds ----------------------------
    // The shared library (source:"library", seeded by scripts/seed-sounds.js) and every
    // creator's own uploads live in the same collection — readable by anyone (the sound picker
    // and Explore's Trending Sounds need to work for signed-out visitors too), but only the
    // uploader may edit or delete their own creator sound. Library sounds have no `uploadedBy`,
    // so update covers the one case that DOES need to be open to any signed-in user:
    // incrementSoundUsage()'s usageCount bump when someone attaches a library sound to a post.
    match /sounds/{soundId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn()
        && (resource.data.uploadedBy == request.auth.uid
          || !("uploadedBy" in resource.data)
          || request.resource.data.diff(resource.data).affectedKeys().hasOnly(["usageCount"]));
      allow delete: if isSignedIn() && (resource.data.uploadedBy == request.auth.uid || isAdmin());
    }

    // ---------------------------- online status (Sprint Final, Part 9) ----------------------------
    // One doc per user — read by anyone signed in (a DM list needs everyone's dot, a profile
    // page needs its owner's, same "activity data is public to signed-in readers" precedent as
    // `history` above), written only by the owner's own client via lib/onlineStatus.ts's
    // setOnline/setOffline (called on auth state change and on window beforeunload).
    match /onlineStatus/{uid} {
      allow read: if isSignedIn();
      allow write: if isOwner(uid);
    }

    // ---------------------------- typing indicators (Part 10) ----------------------------
    // One doc per conversation, a map of participant uid -> timestamp (or null once they stop).
    // Not scoped to actual conversation membership — a get() on the conversation doc on every
    // keystroke would be expensive, and this app's DM messages already trust senderId alone with
    // no membership check (see chatRooms/messages above) — instead every write may only touch
    // the CALLER'S OWN key, so nobody can spoof someone else's typing state even without one.
    match /typing/{conversationId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.keys().hasOnly([request.auth.uid]);
      allow update: if isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([request.auth.uid]);
    }

    // ---------------------------- stories (Part 7) ----------------------------
    // Public read (any signed-in user can see any active story — the home feed's bar has no
    // per-viewer filtering beyond "followed", which is done client-side against the already-
    // public `following` list, not enforced here). Only the story's own author may create or
    // delete it. `update` is scoped to `viewedBy` only — viewStory() (lib/stories.ts) appending
    // the CALLER'S OWN uid is the one write any other signed-in viewer ever makes to someone
    // else's story.
    match /stories/{storyId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["viewedBy"]);
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    // ---------------------------- ban appeals (Part 5) ----------------------------
    // One doc per uid — a fresh appeal overwrites any previous one (setDoc, not addDoc), so a
    // denied appellant can submit again later without piling up documents. The account submits
    // its own appeal (always starting "pending" — it can't self-approve by writing any other
    // status), and only an admin may transition it to "approved"/"denied".
    match /appeals/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid)
        && request.resource.data.uid == uid
        && request.resource.data.status == "pending";
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ---------------------------- admin: account deletion audit log ----------------------------
    // Written only by app/api/admin/delete-user/route.ts using the Admin SDK (which bypasses
    // these rules entirely) — this match exists only so a client-side admin read of the log
    // (e.g. a future "recently deleted" list) has somewhere to point; no client ever writes here.
    match /deletedAccounts/{entryId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ---------------------------- work bookmarks (Part 3) ----------------------------
    // Dedicated `bookmarks/{workId}/users/{uid}` subcollection (rather than scanning `users` for
    // readingList array-contains) so the manga detail page's live bookmark count can subscribe
    // to one small, cheap collection instead of a project-wide query. Each doc's id is written
    // by, and only ever removable by, the uid it's keyed under.
    match /bookmarks/{workId}/users/{uid} {
      allow read: if true;
      allow write: if isOwner(uid);
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
